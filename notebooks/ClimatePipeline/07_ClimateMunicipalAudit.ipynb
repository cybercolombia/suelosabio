    "    clima_caso['codigoestacion'] = clima_caso['codigoestacion'].astype('string')\n",
    "    clima_caso = clima_caso.loc[\n",
    "        clima_caso['fecha'].eq(FECHA_CASO_AQUITANIA)\n",
